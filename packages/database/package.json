{
  "name": "@repo/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --config ../../prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config ../../prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config ../../prisma.config.ts"
  },
  "dependencies": {
    "@prisma/client": "7.0.0"
  },
  "devDependencies": {
    "prisma": "7.0.0",
    "typescript": "^5.9.3"
  }
}