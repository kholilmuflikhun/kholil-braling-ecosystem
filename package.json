{
  "name": "kholil-braling-ecosystem",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:migrate:dev": "pnpm --filter @repo/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @repo/database db:migrate:deploy"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3",
    "@types/node": "^22.19.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.30.0",
    "typescript-eslint": "^8.35.0",
    "prisma": "7.0.0"
  }
}